          <Stat label="Total students" value={counts.total} icon={<Users />} hint="Registered student profiles" />
          <Stat label="Due within 60 days" value={counts.due} icon={<Clock3 />} hint="Renewal action needed" tone="warning" />
          <Stat label="Expired" value={counts.expired} icon={<AlertCircle />} hint="Past the expiry date" tone="danger" />
          <Stat label="Dates missing" value={counts.missing} icon={<CalendarDays />} hint="Follow up with students" />
        </section>
        {tab === 'renewals' ? <section className="panel">
          <div className="panel-heading"><div><h2>Student renewal register</h2><p>All student profiles and their next expiry dates.</p></div><button className="secondary-button" onClick={loadStudents}><RefreshCw size={16} /> Refresh</button></div>

          <div className="toolbar">
            <div className="search-box">
              <Search size={17} />
              <input
                value={search}
                onChange={e => setSearch(e.target.value)}
                placeholder="Search name, email, or status"
              />
            </div>

            <select
              value={filter}
              onChange={e => setFilter(e.target.value)}
              aria-label="Filter students"
            >
              <option value="all">All students</option>
              <option value="urgent">Urgent renewal application required</option>
              <option value="expired">Expired students only</option>
              <option value="missing">Dates missing</option>
              <option value="verified">Verified profiles</option>
            </select>
          </div>

          <div className="selection-toolbar">
            <label>
              <input
                type="checkbox"
                checked={
                  filteredStudents.length > 0 &&
                  filteredStudents.every(s =>
                    selectedStudents.includes(s.user_id)
                  )
                }
                onChange={e =>
                  setSelectedStudents(prev =>
                    e.target.checked
                      ? [
                        ...new Set([
                          ...prev,
                          ...filteredStudents.map(s => s.user_id)
                        ])
                      ]
                      : prev.filter(
                        id => !filteredStudents.some(s => s.user_id === id)
                      )
                  )
                }
              />
              Select all students shown ({filteredStudents.length})
            </label>

            <span>{selectedStudents.length} selected</span>

            <button
              type="button"
              onClick={() => setTab('messages')}
              disabled={selectedStudents.length === 0}
            >
              Send push message
            </button>
          </div>

          <div className="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Select</th>
                  <th>Student name</th>
                  <th>Roll No.</th>
                  <th>Course</th>
                  <th>Country</th>
                  <th>FRRO issue date</th>
                  <th>Expiry date</th>
                  <th>Time left</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {filteredStudents.map(s => {
                  const days = dayDiff(s.frro?.next_expiry_date);
                  const status = statusFor(s.frro?.next_expiry_date);

                  return (
                    <tr key={s.user_id}>
                      <td>
                        <input
                          type="checkbox"
                          aria-label={`Select ${s.full_name || s.email}`}
                          checked={selectedStudents.includes(s.user_id)}
                          onChange={e =>
                            setSelectedStudents(prev =>
                              e.target.checked
                                ? [...new Set([...prev, s.user_id])]
                                : prev.filter(id => id !== s.user_id)
                            )
                          }
                        />
                      </td>
                      <td>
                        <div className="student-cell">
                          <div className="avatar">
                            {(s.full_name || s.email || '?')
                              .slice(0, 1)
                              .toUpperCase()}
                          </div>
                          <div>
                            <strong>{s.full_name || 'Unnamed student'}</strong>
                            <span>{s.email}</span>
                          </div>
                        </div>
                      </td>
                      <td>{s.roll_no || 'Not entered'}</td>
                      <td>{s.course || 'Not entered'}</td>
                      <td>{s.country || 'Not entered'}</td>
                      <td>{dateLabel(s.frro?.frro_issue_date)}</td>
                      <td>{dateLabel(s.frro?.next_expiry_date)}</td>
                      <td>
                        {days === null
                          ? '—'
                          : days < 0
                            ? `${Math.abs(days)} days overdue`
                            : `${days} days`}
                      </td>
                      <td>
                        <span className={`status-pill ${status.tone}`}>
                          {status.label}
                        </span>
                      </td>
                    </tr>
                  );
                })}

                {!filteredStudents.length && (
                  <tr>
                    <td colSpan="9">
                      <div className="table-empty">
                        {loading
                          ? 'Loading student records…'
                          : 'No students match this view yet.'}
                      </div>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

        </section> : tab === 'history' ? <section className="panel">
          <div className="panel-heading">
            <div>
              <h2>Renewal history</h2>
              <p>Review changes made to students' FRRO dates.</p>
            </div>
            <button className="secondary-button" onClick={loadRenewalHistory}>
              <RefreshCw size={16} /> Refresh
            </button>
          </div>

          <div className="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Previous renewal date</th>
                  <th>New renewal date</th>
                  <th>Previous expiry date</th>
                  <th>New expiry date</th>
                  <th>Changed at</th>
                </tr>
              </thead>
              <tbody>
                {renewalHistory.map(item => (
                  <tr key={item.id}>
                    <td>
                      <div className="student-cell">
                        <div className="avatar">
                          {(item.student?.full_name || '?').slice(0, 1).toUpperCase()}
                        </div>
                        <div>
                          <strong>{item.student?.full_name || 'Unknown student'}</strong>
                          <span>{item.student?.email || item.user_id}</span>
                        </div>
                      </div>
                    </td>
                    <td>{dateLabel(item.previous_renewal_date)}</td>
                    <td>{dateLabel(item.new_renewal_date)}</td>
                    <td>{dateLabel(item.previous_expiry_date)}</td>
                    <td>{dateLabel(item.new_expiry_date)}</td>
                    <td>{new Date(item.changed_at).toLocaleString('en-IN')}</td>
                  </tr>
                ))}
                {!renewalHistory.length && (
                  <tr>
                    <td colSpan="6">
                      <div className="table-empty">
                        No renewal history records found yet.
                      </div>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <div className="table-footer">
            <span>Showing {renewalHistory.length} recent changes</span>
            <span>Latest changes appear first</span>
          </div>


        </section> : <section className="panel message-panel">
          <div className="panel-heading">
            <div>
              <h2>Push messages</h2>
              <p>Send an in-app announcement to the students you selected.</p>
            </div>

            <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
              <button
                type="button"
                className="secondary-button"
                onClick={() => setTab('renewals')}
              >
                <Users size={16} />
                Select students
              </button>

              <div className="message-icon">
                <Send size={20} />
              </div>
            </div>
          </div>

          <form className="message-form" onSubmit={sendAnnouncement}>
            <label>
              Message title
              <input
                value={messageTitle}
                onChange={e => setMessageTitle(e.target.value)}
                maxLength={120}
                required
                placeholder="e.g. FRRO renewal reminder"
              />
            </label>


            <label>
              Message
              <textarea
                value={messageBody}
                onChange={e => setMessageBody(e.target.value)}
                maxLength={3000}
                required
                rows={5}
                placeholder="Write an announcement for students…"
              />
            </label>
            <div className="form-actions">
              <span>
                <Users size={16} /> Recipients: {selectedStudents.length} selected students
              </span>

              <button
                type="submit"
                disabled={sending || selectedStudents.length === 0}
              >
                {sending ? 'Sending…' : 'Send announcement'}
                <Send size={16} />
              </button>
            </div>
          </form>
        </section>}
      </> : (
        <>
          <section className="student-welcome">
            <div className="panel-heading">
              <div>
                <h2>My FRRO dates</h2>
                <p>Keep your renewal and expiry information up to date.</p>
              </div>
              <div className="message-icon">
                <CalendarDays size={20} />
              </div>
            </div>

            <div className="stats-grid">
              <Stat
                label="Previous renewal"
                value={dateLabel(record.previous_renewal_date)}
                icon={<CalendarDays />}
                hint="Your last renewal date"
              />
              <Stat
                label="Next expiry"
                value={dateLabel(record.next_expiry_date)}
                icon={<Clock3 />}
                hint={
                  myDays === null
                    ? 'Expiry date not set'
                    : myDays < 0
                      ? `${Math.abs(myDays)} days overdue`
                      : `${myDays} days remaining`
                }
              />
              <Stat
                label="Next expiry"
                value={dateLabel(record.next_expiry_date)}
                icon={<Clock3 />}
                hint={
                  myDays === null
                    ? 'Expiry date not set'
                    : myDays < 0
                      ? `${Math.abs(myDays)} days overdue`
                      : `${myDays} days remaining`
                }
                tone={
                  myDays !== null && myDays < 0
                    ? 'danger'
                    : myDays !== null && myDays <= 14
                      ? 'danger'
                      : myDays !== null && myDays < 60
                        ? 'warning'
                        : 'success'
                }
              />
            </div>

            <div className="panel">
              <div className="panel-heading">
                <div>
                  <h2>Update FRRO dates</h2>
                  <p>Enter the dates shown on your official documents.</p>
                </div>
                {!editingDates && (
                  <button
                    className="secondary-button"
                    onClick={() => setEditingDates(true)}
                  >
                    Edit dates
                  </button>
                )}
              </div>

              {editingDates ? (

                <form className="message-form" onSubmit={saveDates}>
                  <label>
                    Student name
                    <input
                      value={studentDetails.full_name}
                      onChange={e =>
                        setStudentDetails(prev => ({ ...prev, full_name: e.target.value }))
                      }
                      required
                      placeholder="Full name"
                    />
                  </label>

                  <label>
                    Roll number
                    <input
                      value={studentDetails.roll_no}
                      onChange={e =>
                        setStudentDetails(prev => ({ ...prev, roll_no: e.target.value }))
                      }
                      required
                      placeholder="University roll number"
                    />
                  </label>

                  <label>
                    Course
                    <input
                      value={studentDetails.course}
                      onChange={e =>
                        setStudentDetails(prev => ({ ...prev, course: e.target.value }))
                      }
                      required
                      placeholder="e.g. B.Tech Computer Science"
                    />
                  </label>

                  <label>
                    Country
                    <input
                      value={studentDetails.country}
                      onChange={e =>
                        setStudentDetails(prev => ({ ...prev, country: e.target.value }))
                      }
                      required
                      placeholder="Country of citizenship"
                    />
                  </label>

                  <label>
                    FRRO issue date
                    <input
                      type="date"
                      value={record.frro_issue_date || ''}
                      onChange={e =>
                        setRecord(prev => ({ ...prev, frro_issue_date: e.target.value }))
                      }
                      required
                    />
                  </label>

                  <label>
                    FRRO expiry date
                    <input
                      type="date"
                      value={record.next_expiry_date || ''}
                      onChange={e =>
                        setRecord(prev => ({ ...prev, next_expiry_date: e.target.value }))
                      }
                      required
                    />
                  </label>

                  <label>
                    Previous renewal date (optional)
                    <input
                      type="date"
                      value={record.previous_renewal_date || ''}
                      onChange={e =>
                        setRecord(prev => ({
                          ...prev,
                          previous_renewal_date: e.target.value
                        }))
                      }
                    />
                  </label>

                  <div className="form-actions">
                    <button
                      type="button"
                      className="secondary-button"
                      onClick={() => {
                        setEditingDates(false);
                        loadProfileAndData();
                      }}
                    >
                      Cancel
                    </button>

                    <button
                      type="submit"
                      className="primary-button"
                      disabled={saving}
                    >
                      {saving ? 'Saving…' : 'Save details'}
                    </button>
                  </div>
                </form>

              ) : (
                <p>
                  {record.next_expiry_date
                    ? `Your current expiry date is ${dateLabel(record.next_expiry_date)}.`
                    : 'You have not entered your FRRO dates yet. Select Edit dates to add them.'}
                </p>
              )}
            </div>
          </section>

          <section className="panel">
            <div className="panel-heading">
              <div>
                <h2>Messages and announcements</h2>
                <p>Updates from your student services administrator.</p>
              </div>
              <div className="message-icon">
                <Bell size={20} />
              </div>
            </div>

            {notifications.length ? (
              <div className="notification-list">
                {notifications.map(notification => (
                  <article
                    className="notification-item"
                    key={notification.id}
                  >
                    <div>
                      <h3>{notification.title}</h3>
                      <p>{notification.body}</p>
                      <span>
                        {new Date(notification.created_at).toLocaleString('en-IN')}
                      </span>
                    </div>

                    {!notification.read_at && (
                      <button
                        className="secondary-button"
                        onClick={() => markRead(notification.id)}
                      >
                        Mark as read
                      </button>
                    )}
                  </article>
                ))}
              </div>
            ) : (
              <p className="table-empty">No messages yet.</p>
            )}
          </section>
        </>
      )}

      <footer className="page-footer">
        <strong>MRU FRRO Tracker</strong>
        <span>•</span>
        Keep your dates accurate and follow official FRRO guidance.

        <div className="app-signature">
          <p>
            App developed by <strong>Mr Blessed Chirovamayi</strong>
          </p>
          <p>Undergraduate Mechanical Engineer</p>
          <p>Manav Rachna University</p>
          <p>24/10/2026 @ 1500 hrs</p>
        </div>
      </footer>
    </main>
  </div>;
}